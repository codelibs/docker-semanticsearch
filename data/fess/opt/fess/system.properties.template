#system.properties
#
# Seeded to data/fess/opt/fess/system.properties by bin/setup.sh on first run only;
# after that Fess owns the live file (Admin > General rewrites it).
#
# content_chunker.* is deliberately NOT listed here even though this is its
# configuration channel: those keys are driven from .env through
# -Dfess.system.content_chunker.* in compose.yaml, and a key present in this file
# would take precedence over the -D and freeze the value against .env edits.
theme.default=semanticlens
suggest.document=true
suggest.searchlog=true
web.api.json=true
web.api.popularword=true
login.required=false
login.link.enabled=true
result.collapsed=false
crawling.incremental=true
crawling.thread.count=5
thumbnail.enabled=false
search.log=true
user.info=true
user.favorite=false
purge.searchlog.day=90
purge.suggest.searchlog.day=30
purge.joblog.day=90
purge.userinfo.day=90
day.for.cleanup=90
csv.file.encoding=UTF-8
append.query.parameter=false
ldap.memberof.attribute=memberOf
failure.countthreshold=-1
