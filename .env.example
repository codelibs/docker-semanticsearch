# Copy to .env and override as needed: cp .env.example .env
# All values fall back to the defaults below when no .env is present.

# --- Image versions ---
FESS_VERSION=15.7.0
OPENSEARCH_VERSION=3.7.0
SEMANTIC_PLUGIN_VERSION=15.7.0

# --- Embedding model ---
# Registered and deployed automatically by the init-semantic service.
# MODEL_DIMENSION / MODEL_SPACE_TYPE / MODEL_ENGINE / MODEL_METHOD are baked into the
# index mapping at first start. Changing MODEL_NAME or MODEL_DIMENSION afterwards
# requires a reindex (Admin > Maintenance).
MODEL_NAME=huggingface/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_VERSION=1.0.1
MODEL_DIMENSION=384
MODEL_SPACE_TYPE=cosinesimil
MODEL_ENGINE=lucene
MODEL_METHOD=hnsw
# model_format for OpenSearch ML registration
MODEL_FORMAT=TORCH_SCRIPT
SEMANTIC_MIN_SCORE=0.5

# --- Semantic init (init-semantic service) ---
# Text chunking token limit for the neural pipeline
CHUNK_TOKEN_LIMIT=100
# Overlap rate for text chunking in the neural pipeline
CHUNK_OVERLAP_RATE=0.1
# Seconds to wait for model register/deploy
MAX_WAIT=900

# --- UI theme (synced from fess-themes by bin/setup.sh) ---
# Available static themes: semanticlens (default; shows per-result searcher badges),
# nomadkit, docsearch, docuforge, rawblock, voicebox.
# The directory name must equal theme.yml#name.
THEME_NAME=semanticlens
FESS_THEMES_REF=main
# FESS_THEMES_REPO=https://github.com/codelibs/fess-themes.git
# FESS_THEMES_DIR=../fess-workspace/repos/fess-themes   # copy from a local checkout instead of cloning

# --- OpenSearch heap (dev / production overlay) ---
OPENSEARCH_HEAP=2g
OPENSEARCH_HEAP_PROD=3g

# --- Fess initial admin password (change for any non-local deployment) ---
FESS_ADMIN_PASSWORD=admin

# --- Public domain for the https-portal reverse proxy ---
# If you change this, also rename data/https-portal/conf/<domain>.ssl.conf.erb to match.
DOMAIN=semantic.codelibs.org
