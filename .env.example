# docker-semanticsearch environment (Fess 15.8)
#
# Copy to .env and adjust. Every value below also has a default in compose.yaml,
# so an empty .env still boots.

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
FESS_VERSION=15.8.0
# Fess 15.8 always writes "index.knn": true and a knn_vector mapping into the
# document index, so the search engine MUST carry the k-NN plugin.
# ghcr.io/codelibs/fess-opensearch does; an OpenSearch "minimal" distribution
# does not, and Fess would fail to create its index at all.
OPENSEARCH_VERSION=3.8.0

# ---------------------------------------------------------------------------
# Embedding model (OpenSearch ML Commons)
# ---------------------------------------------------------------------------
# Registered and deployed by the init-semantic container. Fess 15.8 generates
# embeddings itself by calling the model's _predict API, so no ingest pipeline
# is involved (that was the 15.7 fess-webapp-semantic-search design).
MODEL_NAME=huggingface/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_VERSION=1.0.1
MODEL_FORMAT=TORCH_SCRIPT
# Must match the model. Baked into the index mapping when the index is created,
# so changing it later requires a reindex.
MODEL_DIMENSION=384
# Seconds to wait for model registration + deployment (first run downloads ~490MB).
MODEL_MAX_WAIT=900

# ---------------------------------------------------------------------------
# Chunking (Fess core: content_chunker.length.*)
# ---------------------------------------------------------------------------
# Chunk size is in CHARACTERS and has to stay inside the embedding model's token
# window: anything beyond it is truncated before the vector is computed, silently
# and with no error. paraphrase-multilingual-MiniLM-L12-v2 accepts 128 tokens,
# which is roughly 250 Japanese characters. (Fess core defaults to 800, a size
# meant for 512-token models -- see MODEL_NAME before raising this.)
# Boundary-aware splitting makes the real chunk length about 0.8x-1.05x of this.
CHUNK_SIZE=250
# Overlap is 0 by default. Fess stores the chunks back into the searchable `content`
# array, so overlapped text is indexed twice: BM25 term frequencies get inflated and
# highlights can repeat. Fess logs a warning at boot whenever this is non-zero. Raise
# it only if semantic recall across chunk boundaries matters more than BM25 accuracy.
CHUNK_OVERLAP=0
# Documents that would produce more chunks than this are skipped
# (content_chunk_status=skipped). Small chunks mean many chunks, so this sits
# above the core default of 1000.
MAX_CHUNKS_PER_DOC=2000

# ---------------------------------------------------------------------------
# Vector search (Fess core: content_chunker.search.*)
# ---------------------------------------------------------------------------
# method / engine / space_type are baked into the mapping at index-creation time.
KNN_METHOD=hnsw
# lucene or faiss; both work on ghcr.io/codelibs/fess-opensearch.
KNN_ENGINE=lucene
KNN_SPACE_TYPE=cosinesimil
KNN_K=100
# Minimum cosine similarity (0-1) for a document to survive the semantic branch.
# Only honoured while KNN_SPACE_TYPE=cosinesimil.
SEMANTIC_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# Content Chunk Vector Indexer job
# ---------------------------------------------------------------------------
# Fess ships this scheduler job disabled at "0 13 * * *". init-fess-chunk enables
# it with the cron below and, by default, launches it once immediately so the
# first crawl gets vectors without waiting.
CHUNK_JOB_CRON=0 * * * *
CHUNK_JOB_AUTOSTART=true
# Seconds to wait after enabling before launching. Must exceed the Fess
# `scheduler.monitor.interval` (default 30) or the launch hits a job the scheduler
# has not registered yet and Fess logs a stack trace.
CHUNK_JOB_START_DELAY=35
CHUNK_JOB_CONCURRENCY=2
CHUNK_JOB_BULK_SIZE=20
# Seconds init-fess-chunk waits for the job to become launchable.
CHUNK_SETUP_MAX_WAIT=300

# ---------------------------------------------------------------------------
# UI theme (fess-themes)
# ---------------------------------------------------------------------------
THEME_NAME=semanticlens
FESS_THEMES_REF=main
# FESS_THEMES_REPO=https://github.com/codelibs/fess-themes.git
# FESS_THEMES_DIR=../fess-workspace/repos/fess-themes

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
OPENSEARCH_HEAP=2g
# compose-production.yaml only.
OPENSEARCH_HEAP_PROD=3g

# ---------------------------------------------------------------------------
# Credentials / host
# ---------------------------------------------------------------------------
FESS_ADMIN_PASSWORD=admin

# compose-production.yaml only.
DOMAIN=semantic.codelibs.org
